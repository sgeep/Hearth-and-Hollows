MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 56d596c8d8b1a3f4e8b6c1601d9cdc15, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 307507200
    m_Localized: you hung the Larder Troll's tusks over the bar. i've been looking at them for an hour.
    m_Metadata:
      m_Items: []
  - m_Id: 332673024
    m_Localized: if the stove catches fire again, they're the first thing i'm saving. after the bomb.
    m_Metadata:
      m_Items: []
  - m_Id: 332673025
    m_Localized: they do look good up there.
    m_Metadata:
      m_Items: []
  - m_Id: 332673026
    m_Localized: they look terrifying. that's what good looks like.
    m_Metadata:
      m_Items: []
  - m_Id: 332673027
    m_Localized: again? the stove's been on fire?
    m_Metadata:
      m_Items: []
  - m_Id: 332673028
    m_Localized: only the once. twice. it's fine, i was there both times.
    m_Metadata:
      m_Items: []
  - m_Id: 332673029
    m_Localized: the tusks are up. good. they keep an eye on the stew for me.
    m_Metadata:
      m_Items: []
  - m_Id: 332673030
    m_Localized: the wall over the bar is still bare. it's begging for something with teeth.
    m_Metadata:
      m_Items: []
  - m_Id: 332673031
    m_Localized: this kitchen's too quiet. nothing on the walls is looking at us.
    m_Metadata:
      m_Items: []
  - m_Id: 332673032
    m_Localized: bring me something big from the Hollows. something with teeth. it goes over the bar.
    m_Metadata:
      m_Items: []
  - m_Id: 332673033
    m_Localized: i'll see what i can find.
    m_Metadata:
      m_Items: []
  - m_Id: 332673034
    m_Localized: big teeth. small teeth are just cutlery.
    m_Metadata:
      m_Items: []
  - m_Id: 332673035
    m_Localized: maybe later.
    m_Metadata:
      m_Items: []
  - m_Id: 332673036
    m_Localized: later is when things sneak up on you. but fine.
    m_Metadata:
      m_Items: []
  - m_Id: 332673037
    m_Localized: the tusks over the bar are a talking point. a guest asked if they bite. i said only on weekends.
    m_Metadata:
      m_Items: []
  - m_Id: 332673038
    m_Localized: do they?
    m_Metadata:
      m_Items: []
  - m_Id: 332673039
    m_Localized: i haven't checked. i'm not going to check.
    m_Metadata:
      m_Items: []
  - m_Id: 332673040
    m_Localized: good evening, [lua(HH_PlayerName())]. the ledger and i are on speaking terms again.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
