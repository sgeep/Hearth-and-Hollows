/* Hearthdelve placeholder UI styles. Rustic parchment/wood art comes later (GDD 8.2). */

:root {
    --hd-ink: rgb(243, 232, 210);
    --hd-ink-dim: rgb(190, 176, 150);
    --hd-panel: rgba(28, 20, 16, 0.92);
    --hd-panel-edge: rgb(120, 86, 52);
    --hd-essence: rgb(118, 206, 214);
    --hd-essence-low: rgb(232, 98, 88);
    --hd-poor: rgb(160, 138, 124);
    --hd-standard: rgb(220, 220, 220);
    --hd-fine: rgb(102, 180, 255);
    --hd-premium: rgb(255, 204, 64);
    color: var(--hd-ink);
    font-size: 16px;
}

/* ---------- HUD ---------- */

.hd-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 16px;
    justify-content: space-between;
}

.hd-hud__top {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.hd-essence {
    width: 320px;
}

.hd-essence__label {
    -unity-font-style: bold;
    margin-bottom: 4px;
    color: var(--hd-ink);
}

#essence-bar {
    height: 16px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 2px;
    border-color: var(--hd-panel-edge);
    border-radius: 3px;
    transition-property: scale;
    transition-duration: 0.08s;
}

#essence-fill {
    height: 100%;
    width: 100%;
    background-color: var(--hd-essence);
    transition-property: width;
    transition-duration: 0.15s;
}

.hd-essence--low #essence-fill {
    background-color: var(--hd-essence-low);
}

.hd-essence--hit {
    scale: 1.06 1.3;
    border-color: var(--hd-essence-low);
}

.hd-feed {
    width: 360px;
    align-items: flex-end;
}

.hd-feed__entry {
    background-color: var(--hd-panel);
    padding: 4px 10px;
    margin-bottom: 4px;
    border-radius: 3px;
    border-left-width: 4px;
    -unity-text-align: middle-right;
}

.hd-feed__entry--destroyed {
    -unity-font-style: italic;
    color: var(--hd-ink-dim);
}

.hd-hud__bottom {
    align-items: center;
}

.hd-hint {
    background-color: var(--hd-panel);
    border-color: var(--hd-premium);
    border-width: 2px;
    padding: 6px 12px;
    margin-bottom: 8px;
    border-radius: 4px;
}

.hd-satchel__label {
    color: var(--hd-ink-dim);
    font-size: 12px;
    margin-bottom: 2px;
}

#satchel-slots {
    flex-direction: row;
}

#satchel-slots > .hd-slot {
    width: 48px;
    height: 48px;
    margin: 0 3px;
    padding: 4px;
    background-color: var(--hd-panel);
    border-width: 2px;
    border-color: var(--hd-panel-edge);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

#satchel-slots .hd-slot__swatch {
    width: 22px;
    height: 22px;
    border-radius: 3px;
}

#satchel-slots .hd-slot__quality {
    position: absolute;
    left: 3px;
    top: 1px;
    font-size: 11px;
    -unity-font-style: bold;
}

#satchel-slots .hd-slot__count {
    position: absolute;
    right: 3px;
    bottom: 1px;
    font-size: 11px;
}

/* Freshness: a thin bar under each slot (length, plus a % label on full-size slots). */
.hd-slot__fresh {
    height: 4px;
    width: 100%;
    margin-top: 2px;
    background-color: rgba(0, 0, 0, 0.5);
}

#satchel-slots .hd-slot__fresh {
    position: absolute;
    left: 3px;
    right: 3px;
    bottom: -1px;
    width: auto;
}

.hd-slot__fresh-fill {
    height: 100%;
    background-color: rgb(120, 200, 110);
}

.hd-slot__freshness {
    font-size: 11px;
    color: var(--hd-ink-dim);
}

.hd-day {
    color: var(--hd-ink);
    -unity-font-style: bold;
    margin: 0 12px;
}

/* ---------- Modal screens ---------- */

.hd-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(8, 6, 12, 0.78);
    align-items: center;
    justify-content: center;
}

.hd-panel {
    background-color: var(--hd-panel);
    border-width: 3px;
    border-color: var(--hd-panel-edge);
    border-radius: 6px;
    padding: 24px 28px;
    max-width: 1000px;
    align-items: center;
}

.hd-title {
    font-size: 32px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.hd-subtitle {
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--hd-ink-dim);
    margin-bottom: 18px;
    max-width: 760px;
}

#slot-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 14px;
}

#slot-row > .hd-slot {
    width: 140px;
    min-height: 140px;
    margin: 4px;
    padding: 10px 6px;
    background-color: rgba(60, 44, 32, 1);
    border-width: 3px;
    border-color: var(--hd-panel-edge);
    border-radius: 5px;
    align-items: center;
    justify-content: flex-start;
    color: var(--hd-ink);
}

#slot-row > .hd-slot:hover,
#slot-row > .hd-slot:focus {
    border-color: var(--hd-ink);
    background-color: rgba(84, 62, 44, 1);
}

#slot-row > .hd-slot--selected {
    border-color: var(--hd-premium);
    background-color: rgba(96, 72, 30, 1);
}

#slot-row > .hd-slot:disabled {
    opacity: 0.35;
}

#slot-row .hd-slot__swatch {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    margin-bottom: 6px;
}

#slot-row .hd-slot__name {
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

#slot-row .hd-slot__quality,
#slot-row .hd-slot__prep,
#slot-row .hd-slot__count {
    font-size: 13px;
}

.hd-selection {
    font-size: 18px;
    margin-bottom: 14px;
    color: var(--hd-premium);
}

.hd-buttons {
    flex-direction: row;
}

.hd-button {
    min-width: 200px;
    padding: 8px 16px;
    margin: 0 6px;
    font-size: 18px;
    background-color: rgba(84, 62, 44, 1);
    border-color: var(--hd-panel-edge);
    border-width: 2px;
    color: var(--hd-ink);
}

.hd-button:hover,
.hd-button:focus {
    border-color: var(--hd-ink);
    background-color: rgba(110, 82, 56, 1);
}

/* Quality text colours — always paired with the tier name, never colour alone. */
.hd-quality--poor { color: var(--hd-poor); border-left-color: var(--hd-poor); }
.hd-quality--standard { color: var(--hd-standard); border-left-color: var(--hd-standard); }
.hd-quality--fine { color: var(--hd-fine); border-left-color: var(--hd-fine); }
.hd-quality--premium { color: var(--hd-premium); border-left-color: var(--hd-premium); }
