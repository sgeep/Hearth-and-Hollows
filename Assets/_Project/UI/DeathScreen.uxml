<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Hearthdelve.uss" />
    <ui:VisualElement name="screen" class="hd-screen">
        <ui:VisualElement class="hd-panel">
            <ui:Label name="title" class="hd-title" />
            <ui:Label name="subtitle" class="hd-subtitle" />
            <ui:VisualElement name="slot-row" />
            <ui:Label name="selection" class="hd-selection" />
            <ui:VisualElement class="hd-buttons">
                <ui:Button name="keep-nothing" class="hd-button" />
                <ui:Button name="confirm" class="hd-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
