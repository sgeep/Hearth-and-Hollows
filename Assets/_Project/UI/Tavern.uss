/* Tavern placeholder UI. Warm palette; parchment/chalkboard art later (GDD 8.2). */

/* ---------- Prep ---------- */

.hd-prep {
    width: 1000px;
    max-width: 1000px;
}

.hd-prep__columns {
    flex-direction: row;
    align-self: stretch;
    margin-bottom: 12px;
}

.hd-prep__column {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 8px;
}

.hd-prep__header {
    -unity-font-style: bold;
    color: var(--hd-ink);
    margin-bottom: 6px;
}

.hd-prep__stock {
    height: 300px;
    background-color: rgba(0, 0, 0, 0.25);
    padding: 6px;
    margin-bottom: 6px;
}

.hd-prep__stock Label {
    font-size: 14px;
    margin-bottom: 2px;
}

.hd-prep__empty {
    color: var(--hd-ink-dim);
    -unity-font-style: italic;
}

.hd-prep__recipes {
    flex-direction: column;
}

.hd-recipe {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 6px 10px;
    margin: 3px 0;
    background-color: rgba(60, 44, 32, 1);
    border-width: 2px;
    border-color: var(--hd-panel-edge);
    border-radius: 4px;
    color: var(--hd-ink);
}

.hd-recipe:hover,
.hd-recipe:focus {
    border-color: var(--hd-ink);
}

.hd-recipe:disabled {
    opacity: 0.4;
}

.hd-recipe.hd-slot--selected,
.hd-button.hd-slot--selected {
    border-color: var(--hd-premium);
    background-color: rgba(96, 72, 30, 1);
}

.hd-recipe__swatch {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    margin-right: 8px;
}

.hd-recipe__name {
    -unity-font-style: bold;
    margin-right: 10px;
}

.hd-recipe__details {
    font-size: 13px;
    color: var(--hd-ink-dim);
}

.hd-prep__staff {
    align-items: center;
    margin-bottom: 12px;
}

.hd-button--small {
    min-width: 110px;
    font-size: 14px;
    padding: 4px 8px;
}

/* ---------- Service HUD ---------- */

.hd-tavern-bar {
    flex-direction: row;
    align-self: center;
    background-color: var(--hd-panel);
    border-radius: 4px;
    padding: 4px 12px;
}

.hd-tavern-bar__item {
    margin: 0 10px;
    font-size: 18px;
}

.hd-tavern-bar__clock {
    -unity-font-style: bold;
}

.hd-tag--last-orders {
    color: var(--hd-essence-low);
    -unity-font-style: bold;
}

.hd-tavern-side {
    position: absolute;
    right: 16px;
    top: 64px;
    width: 300px;
}

.hd-tavern-card {
    background-color: var(--hd-panel);
    border-radius: 4px;
    padding: 8px;
    margin-bottom: 8px;
}

.hd-menu-row,
.hd-ticket {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
    font-size: 14px;
}

.hd-menu-row--sold-out Label {
    color: var(--hd-ink-dim);
}

.hd-tag--sold-out {
    margin-left: 8px;
    padding: 0 6px;
    background-color: rgb(150, 50, 40);
    color: var(--hd-ink);
    border-radius: 3px;
    -unity-font-style: bold;
}

.hd-ticket__state {
    margin-left: auto;
    color: var(--hd-ink-dim);
    font-size: 12px;
}

.hd-ticket--ready .hd-ticket__state {
    color: var(--hd-premium);
    -unity-font-style: bold;
}

.hd-ticket--spare > Label {
    -unity-font-style: italic;
}

.hd-spill {
    align-items: center;
    margin-bottom: 6px;
}

.hd-spill__bar {
    width: 200px;
    height: 12px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 2px;
    border-color: var(--hd-panel-edge);
}

.hd-spill__fill {
    height: 100%;
    width: 0;
    background-color: var(--hd-essence-low);
}

/* ---------- Minigame panels ---------- */

.hd-minigame-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.hd-minigame {
    width: 520px;
}

.hd-minigame__prompt {
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 10px;
}

.hd-grill__track {
    width: 440px;
    height: 28px;
    background-color: rgb(120, 60, 40);
    border-width: 2px;
    border-color: var(--hd-panel-edge);
    margin-top: 8px;
}

.hd-grill__band {
    position: absolute;
    top: 0;
    bottom: 0;
    background-color: rgb(230, 170, 60);
}

.hd-grill__burn {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 4%;
    background-color: rgb(30, 20, 20);
}

.hd-grill__needle {
    position: absolute;
    top: -6px;
    bottom: -6px;
    width: 4px;
    margin-left: -2px;
    background-color: var(--hd-ink);
}

.hd-tap__glass {
    width: 90px;
    height: 220px;
    margin-top: 8px;
    border-width: 3px;
    border-top-width: 0;
    border-color: rgb(200, 220, 230);
    background-color: rgba(200, 220, 230, 0.12);
    transform-origin: bottom;
}

.hd-tap__liquid {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgb(210, 150, 50);
}

.hd-tap__foam {
    position: absolute;
    left: 0;
    right: 0;
    height: 0;
    background-color: rgb(245, 240, 225);
}

.hd-tap__foam-zone {
    position: absolute;
    left: -14px;
    width: 10px;
    background-color: rgba(120, 230, 120, 0.8);
}

.hd-tap__line {
    position: absolute;
    left: -6px;
    right: -6px;
    height: 2px;
    background-color: rgb(255, 90, 70);
}

/* Chopping: the board sits at a fixed share of the screen (ChopSettings.boardLeft/boardWidth,
   set from code) so the mouse maps straight onto it. */
.hd-chop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hd-chop__header {
    position: absolute;
    top: 16%;
    left: 25%;
    width: 50%;
    align-items: center;
}

.hd-chop__board {
    position: absolute;
    top: 50%;
    height: 130px;
    background-color: rgb(150, 104, 62);
    border-width: 3px;
    border-color: var(--hd-panel-edge);
    border-radius: 6px;
}

.hd-chop__food {
    position: absolute;
    left: 3%;
    right: 3%;
    top: 28px;
    bottom: 28px;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.45);
}

.hd-chop__marks {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hd-chop__line {
    position: absolute;
    top: 16px;
    bottom: 16px;
    width: 2px;
    margin-left: -1px;
    background-color: rgba(255, 255, 255, 0.85);
}

.hd-chop__cut {
    position: absolute;
    top: 8px;
    bottom: 8px;
    width: 5px;
    margin-left: -2px;
}

.hd-chop__knife {
    position: absolute;
    top: -46px;
    bottom: -8px;
    width: 6px;
    margin-left: -3px;
    background-color: rgb(215, 220, 230);
    border-width: 1px;
    border-color: rgb(50, 50, 60);
}

.hd-chop__timer {
    position: absolute;
    left: 0;
    bottom: -12px;
    height: 6px;
    background-color: rgb(230, 170, 60);
}

/* ---------- Results ---------- */

.hd-results {
    align-items: flex-start;
    margin-bottom: 16px;
}

.hd-results__row {
    font-size: 20px;
    margin-bottom: 4px;
}
